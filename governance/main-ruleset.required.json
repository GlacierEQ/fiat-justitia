{
  "name": "Tower main protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {
      "type": "required_pull_request",
      "parameters": {
        "allowed_merge_methods": ["merge", "squash", "rebase"],
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": true,
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {"context": "required-advanced-exhibit-gate"},
          {"context": "required-nervous-system-contract"},
          {"context": "required-quality-gate"},
          {"context": "required-spiral-verification"},
          {"context": "required-tower-verification"}
        ]
      }
    }
  ],
  "tower_metadata": {
    "schema": "glaciereq.github-main-ruleset.v1",
    "repository": "GlacierEQ/the-tower-of-babel",
    "default_branch": "main",
    "owner_model": "single-maintainer-compatible",
    "external_activation_required": true,
    "verification_script": "scripts/verify_main_ruleset.py"
  }
}
